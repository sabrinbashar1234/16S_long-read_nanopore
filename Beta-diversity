# STAGE 5: VALIDATE MATCHED DESIGN
############################################################

library(dplyr)
library(vegan)
library(ggplot2)
library(ggsci)
library(permute)

output_dir <- "C:/Users/Sabrin/Downloads/"

# Check storage groups
print(table(dat$Storage))

# Check matched samples
print(table(dat$SampleID, dat$Storage))

stopifnot(
  nrow(dat) == 36,
  nlevels(dat$SampleID) == 12,
  !anyNA(dat$Storage),
  !anyNA(dat$SampleID),
  all(table(dat$SampleID, dat$Storage) == 1)
)

cat("\nMatched design verified.\n")


############################################################
# STAGE 6: EXTRACT GENUS ABUNDANCE MATRIX
############################################################

# Select only genus columns
comm_genus <- dat[, genus_cols, drop = FALSE]

# Convert genus abundances to numeric
comm_genus <- as.data.frame(
  lapply(comm_genus, function(x) {
    as.numeric(as.character(x))
  }),
  check.names = FALSE
)

rownames(comm_genus) <- dat$SequenceID

comm_matrix <- as.matrix(comm_genus)

# Check values
stopifnot(
  !anyNA(comm_matrix),
  all(is.finite(comm_matrix)),
  all(comm_matrix >= 0),
  all(rowSums(comm_matrix) > 0)
)

# Examine genus abundance totals
cat("\nRelative abundance row sums:\n")
print(summary(rowSums(comm_matrix)))

# Identify samples with lower totals
row_sum_check <- data.frame(
  SequenceID = dat$SequenceID,
  SampleID = dat$SampleID,
  Storage = dat$Storage,
  TotalAbundance = rowSums(comm_matrix)
)

row_sum_check <- row_sum_check[
  order(row_sum_check$TotalAbundance),
]

print(row_sum_check, row.names = FALSE)

write.csv(
  row_sum_check,
