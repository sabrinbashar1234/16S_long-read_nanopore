############################
# 1. FILE PATHS
############################

genus_file <- paste0(
  "C:/Users/Sabrin/Downloads/",
  "emu_rel_abundance_genus_transposed_cleanIDs.csv"
)

metadata_file <- paste0(
  "C:/Users/Sabrin/Downloads/",
  "metadata_16S_longreads.xlsx"
)

