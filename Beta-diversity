############################
# 2. IMPORT DATA
############################

genus_tab <- read.csv(
  genus_file,
  check.names = FALSE,
  stringsAsFactors = FALSE
)

names(genus_tab)[1] <- "SequenceID"

meta <- readxl::read_xlsx(metadata_file)

genus_tab$SequenceID <- as.character(
  genus_tab$SequenceID
)

meta$SequenceID <- as.character(
  meta$SequenceID
)

# Check required columns
stopifnot(
  all(c("SequenceID", "SampleID", "Storage") %in%
        names(meta))
)

stopifnot(
  !anyDuplicated(genus_tab$SequenceID),
  !anyDuplicated(meta$SequenceID)
)


############################
# 3. IDENTIFY GENUS COLUMNS
############################

# Important:
# Identify genus columns BEFORE merging metadata.
# This prevents numeric metadata from entering
# the Bray-Curtis calculation.

genus_cols <- setdiff(
  names(genus_tab),
  "SequenceID"
)


############################
# 4. MERGE METADATA
############################

dat <- genus_tab %>%
  inner_join(meta, by = "SequenceID") %>%
  mutate(
    SampleID = factor(SampleID),
    Storage = factor(
      Storage,
      levels = c(
        "Baseline",
        "Test",
        "GoldStd"
      ),
      labels = c(
        "Baseline",
        "-20C",
        "-80C"
      )
    )
  )

cat("\nSamples by storage condition:\n")
print(table(dat$Storage))

cat("\nChild by storage condition:\n")
print(table(dat$SampleID, dat$Storage))

