)

# IMPORTANT:
# Keep the original abundance values.
# Do not force each row to sum to 1.
# Bray-Curtis accepts nonnegative abundance data.


############################################################
# STAGE 7: BRAY-CURTIS DISTANCE
############################################################

bray_genus <- vegdist(
  comm_matrix,
  method = "bray"
)

cat("\nBray-Curtis distance calculated.\n")


############################################################
# STAGE 8: OVERALL MATCHED PERMANOVA
# Baseline vs -20C vs -80C
############################################################

set.seed(123)

perm_all <- permute::how(
  nperm = 9999,
  blocks = dat$SampleID,
  within = permute::Within(type = "free")
)

# Account for child identity
permanova_all <- adonis2(
  bray_genus ~ SampleID + Storage,
  data = dat,
  permutations = perm_all,
  by = "terms"
)

cat("\nOVERALL MATCHED PERMANOVA:\n")
print(permanova_all)

overall_results <- as.data.frame(permanova_all)
overall_results$Term <- rownames(overall_results)

write.csv(
  overall_results,
  file.path(output_dir, "PERMANOVA_overall_3conditions.csv"),
  row.names = FALSE
)


############################################################
# STAGE 9: FUNCTION FOR MATCHED PAIRWISE PERMANOVA
############################################################

run_paired_permanova <- function(group1, group2) {
  
  # Select the two storage conditions
  keep <- dat$Storage %in% c(group1, group2)
  
  dat_pair <- droplevels(
    dat[keep, , drop = FALSE]
  )
  
  comm_pair <- comm_matrix[
    keep,
    ,
    drop = FALSE
  ]
  
  # Verify matched pairs
  stopifnot(
    nrow(dat_pair) == 24,
    all(table(
      dat_pair$SampleID,
      dat_pair$Storage
    ) == 1)
  )
  
  # Bray-Curtis
  bray_pair <- vegdist(
    comm_pair,
    method = "bray"
  )
  
  # Restricted permutations
  perm_pair <- permute::how(
    nperm = 9999,
    blocks = dat_pair$SampleID,
    within = permute::Within(type = "free")
  )
  
  # Matched PERMANOVA
  set.seed(123)
  
  fit <- adonis2(
    bray_pair ~ SampleID + Storage,
    data = dat_pair,
    permutations = perm_pair,
    by = "terms"
  )
  
  result <- as.data.frame(fit)
  result$Term <- rownames(result)
  
  storage_result <- result[
    result$Term == "Storage",
    ,
    drop = FALSE
  ]
  
  storage_result$Comparison <- paste(
    group1,
    "vs",
    group2
  )
  
  list(
    model = fit,
    result = storage_result,
    data = dat_pair,
    community = comm_pair,
    distance = bray_pair
  )
}


############################################################
# STAGE 10: PRIMARY COMPARISON
# -20C vs -80C
############################################################

temp_comparison <- run_paired_permanova(
  "-20C",
  "-80C"
)

cat("\nPRIMARY COMPARISON: -20C VS -80C\n")
print(temp_comparison$model)


############################################################
# STAGE 11: SECONDARY COMPARISONS
############################################################

baseline_20 <- run_paired_permanova(
  "Baseline",
  "-20C"
)

baseline_80 <- run_paired_permanova(
  "Baseline",
  "-80C"
)

cat("\nBASELINE VS -20C:\n")
print(baseline_20$model)

cat("\nBASELINE VS -80C:\n")
print(baseline_80$model)


############################################################
# STAGE 12: COMBINE PAIRWISE RESULTS
############################################################

pairwise_results <- bind_rows(
  temp_comparison$result,
  baseline_20$result,
  baseline_80$result
)

# Benjamini-Hochberg correction
pairwise_results$BH_FDR <- p.adjust(
  pairwise_results$`Pr(>F)`,
  method = "BH"
)

cat("\nPAIRWISE PERMANOVA SUMMARY:\n")
print(pairwise_results)

write.csv(
  pairwise_results,
  file.path(output_dir, "PERMANOVA_pairwise_matched.csv"),
  row.names = FALSE
)


############################################################
# STAGE 13: NMDS - ALL THREE STORAGE CONDITIONS
############################################################

set.seed(123)

nmds_all <- metaMDS(
  comm_matrix,
  distance = "bray",
  k = 2,
  trymax = 100,
  trace = FALSE
)

scores_all <- as.data.frame(
  scores(nmds_all, display = "sites")
)

scores_all$Storage <- dat$Storage
scores_all$SampleID <- dat$SampleID

theme_pub <- theme_classic(base_size = 14) +
  theme(
    axis.text = element_text(face = "bold"),
    axis.title = element_text(face = "bold"),
    legend.text = element_text(face = "bold"),
    legend.title = element_text(face = "bold")
  )

p_all <- ggplot(
  scores_all,
  aes(
    x = NMDS1,
    y = NMDS2,
    color = Storage
  )
) +
  geom_point(size = 3, alpha = 0.9) +
  stat_ellipse(
    type = "t",
    level = 0.95,
    linetype = 2,
    linewidth = 0.8
  ) +
  scale_color_npg() +
  labs(
    title = "Genus-level beta diversity",
    subtitle = paste0(
      "Stress = ",
      round(nmds_all$stress, 3)
    ),
    x = "NMDS1",
    y = "NMDS2",
    color = "Storage"
  ) +
  theme_pub

print(p_all)

